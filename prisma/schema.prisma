// Banco do app: MySQL (EasyPanel em produção). DATABASE_URL no Environment do app.
generator client {
  provider      = "prisma-client-js"
  // native = Windows (dev) | debian = container Linux do EasyPanel (openssl 3)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  nome                 String
  email                String    @unique
  senhaHash            String? // null = conta só com Google (sem senha local)
  googleId             String?   @unique // id do Google (sub) quando entra com Google
  role                 String    @default("user") // "admin" | "user" | "demo"
  bloqueado            Boolean   @default(false) // true = derruba a sessão e impede novo login
  ferramentasLiberadas Boolean   @default(true) // false = admin cortou o acesso de gerar (editor/cortes/lote/leads)
  criadoEm             DateTime  @default(now())
  vistoEm              DateTime? // última atividade (presença "online/visto há X"); atualizado no layout

  // Carteira de crédito (produção) + assinatura (biblioteca)
  saldoCentavos   Int       @default(0) // saldo de crédito em centavos de R$
  assinante       Boolean   @default(false) // assinatura ativa libera a biblioteca
  assinaturaAte   DateTime? // vencimento da assinatura
  creditoMensalEm DateTime? // última vez que recebeu o 1 min mensal

  // Nível de conta (antifraude de reembolso): bronze -> prata -> ouro.
  // Limita vídeos/dia, simultâneos e a liberação de crédito comprado.
  nivel          String  @default("bronze") // "bronze" | "prata" | "ouro"
  nivelManual    Boolean @default(false) // admin fixou o nível na mão (o automático não mexe)
  suspeita       Boolean @default(false) // marcada como suspeita: cai pra bronze e trava lá
  dividaCentavos Int     @default(0) // saldo devedor pós-reembolso: > 0 trava a geração

  // BYO key: chave ElevenLabs do usuário, CIFRADA (AES-256-GCM). null = usa a plataforma.
  elevenKey String? @db.Text

  jobs           Job[]
  leads          Lead[]
  transacoes     CreditoTransacao[]
  notificacoes   Notificacao[]
  bonusInstagram BonusInstagram?
  avatares       Avatar[]
  cenarios       CenarioUsuario[]
  produtos       ProdutoUsuario[]
  personagens    PersonagemUsuario[]
  imagens        ImagemGerada[]
  sugestoes      Sugestao[]
  apoios         Apoio[]
  reportes       ReporteVideo[]
  chatMensagens  ChatMensagem[]
  atividades     AtividadeDia[]
  liberacoes     CreditoLiberacao[]

  @@index([vistoEm])
}

// Um registro por usuário por dia de uso (fuso de SP). Base das regras de nível:
// "logou em 5 dos últimos 8 dias" (Prata) e "10 dos últimos 30" (Ouro).
model AtividadeDia {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dia    String @db.VarChar(10) // "YYYY-MM-DD" no fuso America/Sao_Paulo

  @@unique([userId, dia])
  @@index([userId, dia])
}

// Crédito comprado que ficou PRESO na quarentena da garantia (nível bronze/prata
// libera só uma parte na hora). O restante cai no saldo no 8º dia da compra,
// quando o direito de reembolso da Cakto/Kiwify já expirou. Se o pedido for
// reembolsado antes, a liberação é cancelada (o crédito preso nunca entra).
model CreditoLiberacao {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  valor     Int // centavos presos aguardando liberação
  liberaEm  DateTime // quando cai no saldo (compra + 8 dias)
  aplicado  Boolean  @default(false) // já caiu no saldo
  cancelado Boolean  @default(false) // pedido reembolsado: nunca entra
  orderId   String?  @db.VarChar(64) // pedido Cakto/Kiwify que originou
  descricao String?  @db.VarChar(255)
  criadoEm  DateTime @default(now())

  @@index([userId, aplicado, cancelado])
  @@index([aplicado, cancelado, liberaEm])
  @@index([orderId])
}

// Chat interno 1:1 (admin <-> usuario). SO o admin abre a conversa; a caixinha
// aparece pro usuario quando existe mensagem. Texto ou audio (URL no serverrk).
model ChatMensagem {
  id       String   @id @default(cuid())
  userId   String // dono da conversa (a pessoa)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autor    String   @default("admin") // "admin" | "user"
  texto    String?  @db.Text
  audioUrl String?  @db.VarChar(500) // audio gravado (media.univershoop.com/avatares/chat-*.webm)
  lida     Boolean  @default(false) // lida pelo DESTINATARIO (admin le do user e vice-versa)
  criadoEm DateTime @default(now())

  @@index([userId, criadoEm])
  @@index([userId, lida])
}

// Sugestão/melhoria que o usuário manda. Ele só vê as dele; o admin vê todas.
// Reporte de problema num vídeo gerado (a pessoa acha que saiu errado e pede
// reembolso dos créditos). O admin decide: reembolsa (credita de volta) ou recusa.
// (Job ganhou exclusão com histórico: status "excluido" + quem/quando - ver Job)
model ReporteVideo {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String    @db.VarChar(64) // id do Job reportado (pode já ter sido excluído)
  produto    String    @db.VarChar(255) // nome do vídeo na hora do reporte
  motivo     String    @db.Text
  creditos   Int       @default(0) // créditos gastos no vídeo (o que seria reembolsado)
  status     String    @default("novo") // "novo" | "reembolsado" | "recusado"
  decididoEm DateTime?
  criadoEm   DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

// Doação de apoio ao projeto (Pix pela InfinitePay). É DOAÇÃO PURA: não dá
// crédito, não libera nada, não muda o plano de ninguém. Serve pra registrar
// quem apoiou e quanto, e pra gente agradecer.
//
// O fluxo cria a linha como "aguardando" com o link, e ela só vira "pago"
// depois que o payment_check da InfinitePay confirma. O webhook sozinho NUNCA
// decide: ele não é assinado, então qualquer um poderia forjar (mesma regra do
// webhook da Cakto).
model Apoio {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  valorCentavos Int
  status        String    @default("aguardando") // "aguardando" | "pago" | "cancelado"
  orderNsu      String    @unique // o que mandamos pra InfinitePay e volta no webhook
  transactionNsu String?  // id da transação, só existe depois de pago
  slug          String? // invoice_slug do webhook, usado no payment_check
  linkUrl       String?   @db.Text
  pagoEm        DateTime?
  criadoEm      DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model Sugestao {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  texto         String   @db.Text
  tipo          String   @default("sugestao") // "sugestao" | "melhoria" | "problema"
  status        String   @default("nova") // "nova" | "lida" | "resolvida" (admin gerencia)
  resposta      String?  @db.Text // resposta do admin (o autor vê na aba dele + sininho)
  creditosDados Int      @default(0) // créditos dados de recompensa junto com a resposta
  criadoEm      DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// Avatar criado pelo usuário no "Meus avatares" (quiz -> gpt-image-1). A foto é
// gerada pela OpenAI no app e HOSPEDADA no serverrk (media.univershoop.com/avatares/<id>.png),
// igual ao resto da mídia. Guardamos só a URL e as escolhas do quiz. Custa creditos.
// Produto do PRÓPRIO usuário (foto que ele subiu no Viraliza Lab). Os produtos
// da Shopee ficam em ProdutoShopee e são iguais pra todo mundo; estes são dele.
model ProdutoUsuario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String   @db.VarChar(200)
  imagemUrl String   @db.Text // URL pública no serverrk
  criadoEm  DateTime @default(now())

  @@index([userId, criadoEm])
}

model Avatar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String   @db.VarChar(120)
  genero    String   @default("female") // "female" | "male"
  status    String   @default("pronto") // "pronto" | "erro"
  imagemUrl String   @db.Text // URL publica no serverrk
  escolhas  String?  @db.Text // JSON das escolhas do quiz (referencia)
  criadoEm  DateTime @default(now())

  @@index([userId])
}

// Cenário PRÓPRIO do usuário (foto que ele sobe): aparece só pra ele no passo
// "Cenário" do Lab e na aba Cenários do Personalize com IA. A foto vai como
// referência de LUGAR pro motor (a IA recria o ambiente como fundo).
model CenarioUsuario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String   @db.VarChar(120)
  imagemUrl String   @db.Text // URL pública no serverrk
  criadoEm  DateTime @default(now())

  @@index([userId])
}

// Pedido do bônus de +300 créditos por seguir o Instagram. A liberação é manual
// (a Meta não deixa checar seguir/curtir por API): a pessoa manda o @ dela e o
// admin aprova ou recusa. 1 por usuário (não credita 2x).
model BonusInstagram {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagram   String    @db.VarChar(120) // @ que a pessoa informou (sem o arroba)
  status      String    @default("pendente") // "pendente" | "aprovado" | "recusado"
  creditadoEm DateTime? // quando os 300 créditos foram lançados
  decididoEm  DateTime? // quando o admin decidiu (aprovou/recusou)
  criadoEm    DateTime  @default(now())

  @@index([status])
}

// Notificação do "sininho": uma linha por usuário (fan-out). Aviso automático de
// vídeo pronto/erro OU mensagem que o admin manda pra 1 usuário ou pra todos.
model Notificacao {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     String   @default("admin") // "video_pronto" | "video_erro" | "admin"
  titulo   String   @db.VarChar(255)
  mensagem String?  @db.Text
  link     String?  @db.VarChar(500) // pra onde leva ao clicar (ex: /painel/videos/<id>)
  lida     Boolean  @default(false)
  loteId   String?  @db.VarChar(40) // agrupa um envio do admin pra todos (permite excluir o lote)
  jobId    String?  @db.VarChar(40) // liga ao Job (dedup do aviso automático)
  criadoEm DateTime @default(now())

  @@index([userId, lida])
  @@index([loteId])
}

// Barra horizontal no topo do site. Criada pelo admin, some quando desativada.
model Aviso {
  id         String   @id @default(cuid())
  mensagem   String   @db.Text
  cor        String   @default("azul") // laranja | vermelho | azul | verde
  link       String?  @db.VarChar(500) // link opcional (ex: promoção)
  ativo      Boolean  @default(true)
  alvoUserId String?  @db.VarChar(40) // null = todos; senão só esse usuário vê
  criadoEm   DateTime @default(now())

  @@index([ativo])
}

// Extrato da carteira: cada entrada/saída de crédito do usuário.
model CreditoTransacao {
  id            String   @id @default(cuid())
  // NULL = usuário excluído (auditoria #14): o histórico financeiro (compras,
  // débitos, estornos) NUNCA some em cascata - os totais do painel e a trilha
  // de auditoria das vendas continuam de pé mesmo sem a conta.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tipo          String // compra | debito_geracao | debito_processamento | bonus_assinatura | ajuste_admin | estorno
  valor         Int // centavos; positivo = entrada, negativo = saída
  saldoApos     Int // saldo depois desta transação (centavos)
  descricao     String?  @db.Text
  jobId         String? // liga ao Job quando o débito for de uma geração
  kiwifyOrderId String? // id do pedido na Kiwify (crédito de compra / estorno) - idempotência
  criadoEm      DateTime @default(now())

  @@index([userId])
  @@index([criadoEm])
  @@index([kiwifyOrderId])
  @@index([jobId])
}

// Crédito de uma compra Kiwify de quem AINDA não tem conta (pagou antes de cadastrar).
// Aplicado no cadastro (ou no login) quando a pessoa entra com o mesmo e-mail.
model CreditoPendente {
  id             String   @id @default(cuid())
  email          String
  valorCentavos  Int
  kiwifyOrderId  String   @unique
  assinaturaDias Int      @default(0) // dias de assinatura a conceder junto
  descricao      String?  @db.Text
  aplicado       Boolean  @default(false)
  criadoEm       DateTime @default(now())

  @@index([email, aplicado])
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  produto     String    @db.VarChar(255)
  descricao   String?   @db.Text
  tipo        String    @default("produto") // "produto" | "marca" | "cortes" (link YouTube)
  fonte       String?   @db.Text // link de origem (cortes de qualquer vídeo)
  opcoes      String?   @db.Text // JSON de opções extras (legenda, cor, posição...)
  formato     String    @default("legenda") // "legenda" | "voz"
  vozId       String?   @db.VarChar(64) // voz ElevenLabs escolhida (só no formato "voz"); null = voz padrão
  tom         String    @default("agressivo")
  variantes   Int       @default(1)
  preco       String?
  legendaPos  String    @default("baixo") // posição da legenda: "cima" | "meio" | "baixo"
  status      String    @default("na_fila") // na_fila | renderizando | processando | pronto | erro
  etapa       String?   @db.VarChar(120) // fase atual do render (ex: "Renderizando 1/2"); null fora do render
  duracao     Int?
  saidas      String?   @db.Text // JSON: caminhos web dos vídeos prontos
  midias      String?   @db.Text // JSON: [{arquivo, thumb, legenda, hashtags}] por variante
  erro        String?   @db.Text // mensagem quando status = "erro"
  // exclusão com histórico: o vídeo some pro usuário mas a linha fica (admin audita)
  excluidoEm  DateTime? // quando foi excluído (status vira "excluido")
  excluidoPor String?   @db.VarChar(255) // email de quem excluiu (dono ou admin)
  criadoEm    DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model Lead {
  id              String   @id @default(cuid())
  userId          String // dono do lead - cada pessoa vê só os seus
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chave           String // lugar_id, ou "nome|cidade" quando não há lugar_id
  lugarId         String   @default("")
  nome            String   @db.VarChar(255)
  categoria       String   @default("") @db.VarChar(255)
  telefone        String   @default("")
  site            String?  @db.Text
  email           String   @default("")
  instagram       String?  @db.Text
  whatsapp        String   @default("")
  redeSocial      String?  @db.Text
  nota            Float?
  totalAvaliacoes Int      @default(0)
  scoreLead       Int      @default(0)
  oportunidades   String?  @db.Text
  mensagem        String?  @db.Text
  endereco        String?  @db.Text
  googleMaps      String?  @db.Text
  cidade          String   @default("") @db.VarChar(255)
  uf              String   @default("") @db.VarChar(2)
  nicho           String   @default("") @db.VarChar(255)
  capturadoEm     String   @default("")
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([userId, chave])
  @@index([userId])
  @@index([scoreLead])
  @@index([uf])
  @@index([cidade])
}

model AcervoCategoria {
  slug  String @id
  nome  String
  cover String @default("")
  ordem Int    @default(0)
  total Int    @default(0) // contagem de vídeos (denormalizado, rápido pro índice)
}

model AcervoVideo {
  id            String @id @default(cuid())
  driveId       String @unique
  nome          String @db.VarChar(300)
  categoriaSlug String

  @@index([categoriaSlug])
}

// Produtos virais Shopee (imagem hospedada no Drive). Serve thumbnail + link.
model ProdutoShopee {
  id           String   @id // id do telegram (tg_...)
  driveId      String   @unique // arquivo da imagem no Drive
  titulo       String   @db.VarChar(500)
  link         String?  @db.VarChar(500)
  canal        String?
  migrado      Boolean  @default(false) // true = imagem já está no serverrk (media.univershoop.com), não usa mais o Drive
  adicionadoEm DateTime @default(now())

  @@index([adicionadoEm])
}

// Vídeos virais Shopee. Antigos no Drive; novos (ingest do Telegram) direto no serverrk.
model VideoShopee {
  id           String   @id // id do telegram (tg_...)
  driveId      String?  @unique // arquivo do vídeo no Drive (null = veio direto pro serverrk)
  thumbDriveId String? // JPG do frame real no Drive (capa instantânea; lh3 não faz poster de vídeo)
  titulo       String   @db.VarChar(500)
  link         String?  @db.VarChar(500)
  duracaoSeg   Int      @default(0)
  canal        String?
  categoria    String   @default("") @db.VarChar(255) // nicho do vídeo (ex.: "Utilidades")
  emAlta       Boolean  @default(false) // 🔥 Em alta agora (veio com nicho)
  migrado      Boolean  @default(false) // true = vídeo+thumb já no serverrk (media.univershoop.com), não usa mais o Drive
  adicionadoEm DateTime @default(now())

  @@index([adicionadoEm])
  @@index([emAlta])
  @@index([categoria])
  @@index([categoria, adicionadoEm]) // "mais novos do nicho X" (prateleiras + paginação)
}

// Allowlist de cadastro: só quem comprou na Kiwify (qualquer produto) pode criar
// conta. Populado pelo webhook quando a compra é aprovada. Fecha o farm de crédito.
model AcessoPago {
  email         String   @id
  kiwifyOrderId String?
  produto       String?
  criadoEm      DateTime @default(now())
}

// Pedido de redefinição de senha: guarda só o HASH do token (nunca o token cru).
// O link enviado por e-mail leva o token cru; a gente confere pelo hash. Expira em
// ~30 min e vira "usado" após redefinir (uso único).
model PasswordReset {
  id        String   @id @default(cuid())
  email     String // e-mail que pediu o reset (minúsculo)
  tokenHash String   @unique // SHA-256 do token enviado no link
  expiraEm  DateTime
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([email])
  @@index([expiraEm])
}

// Rate limiter simples (janela fixa por banco): 1 linha por tentativa. Conta as
// tentativas de uma chave (ex.: "login:<ip>") na janela pra travar brute-force/spam.
model RateHit {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
}

// Chaves gerais da plataforma (liga/desliga funcionalidade sem deploy). Uma linha
// por chave, valor em texto. Ex.: "geracao_imagem" = "off" pausa o Lab pra todo
// mundo enquanto o admin resolve algum problema no motor.
model Configuracao {
  chave         String   @id @db.VarChar(60)
  valor         String   @db.VarChar(500)
  atualizadoEm  DateTime @updatedAt
  atualizadoPor String?  @db.VarChar(160) // e-mail do admin que mexeu
}

// Personagem do Viral Boost criado pela pessoa: a fruta dela, a vó dela, o
// mascote da loja. A imagem vira a referencia visual que trava o personagem no
// video, igual as frutas da casa. Fica hospedada no serverrk.
// Galeria "Minhas imagens": TODA imagem que a pessoa gera fica guardada aqui.
// O pulo do gato e o "contexto": como a imagem nasceu dentro do Lab, a gente ja
// sabe produto, influenciador, estilo e cenario dela, entao o botao "Novo video"
// abre o Lab no passo do video sem refazer (e sem cobrar) nada.
model ImagemGerada {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  origem    String   @default("lab") // "lab" | "boost" | "avatar"
  titulo    String   @db.VarChar(500) // nome do produto, da historinha ou do avatar
  imagemUrl String   @db.Text // URL publica no serverrk
  contexto  String?  @db.Text // JSON das escolhas (so "lab" gera video direto)
  favorita  Boolean  @default(false)
  videos    Int      @default(0) // quantos videos ja sairam dessa imagem
  criadoEm  DateTime @default(now())

  @@index([userId, criadoEm])
  @@index([userId, favorita])
}

model PersonagemUsuario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String   @db.VarChar(60)
  jeito     String   @db.VarChar(160) // como ele e (entra no prompt)
  formato   String   @default("frutas") // frutas | senhora | livre
  genero    String   @default("f") // f | m
  imagemUrl String   @db.Text
  criadoEm  DateTime @default(now())

  @@index([userId])
}

// Gasto REAL com as APIs pagas (aba Financas do admin). Uma linha por consumo:
// quem gastou, em qual API, quanto do recurso e o custo estimado em R$.
// userId sem FK de proposito: se a conta for apagada, o historico financeiro fica.
model GastoApi {
  id         String   @id @default(cuid())
  userId     String?  @db.VarChar(64) // dono do gasto; null = gasto do sistema
  jobId      String?  @db.VarChar(64) // Job ligado (quando veio de uma geracao)
  api        String   @db.VarChar(16) // "openai" | "gemini" | "veo" | "eleven" | "grok"
  recurso    String   @db.VarChar(24) // "tokens" | "tokens_img" | "chars" | "segundos" | "imagens"
  quantidade Float    @default(0)
  custoMili  Int      @default(0) // custo em MILESIMOS de centavo de R$ (100000 = R$ 1,00)
  origem     String?  @db.VarChar(32) // ferramenta: "fabrica" | "cortes" | "lab-video" | "avatar" | ...
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([api, criadoEm])
  @@index([userId, criadoEm])
  @@index([jobId])
}
